  "cards": [
    {
      "dot": "cyan",
      "title": "Application boundary",
      "items": [
        "React SPA talks to FastAPI over REST and SSE",
        "LanguageRuntime manages native LangChain chat models & agents (D46)",
        "CompositeAdapter manages domain/media-only adapters and effects"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence contracts",
      "items": [
        "PostgreSQL stores AsyncPostgresSaver checkpoints with tenant RLS",
        "PostgresEffectLedger enforces idempotency and quota reservations",
        "run_gates and run_events persist Human Gate V2 decisions and SSE streams"
      ]
    },
    {
      "dot": "amber",
      "title": "Media and providers",
      "items": [
        "Mock profile writes media to local filesystem deterministically",
        "Live profile writes bytes to private R2 via S3 API",
        "Signed URLs are derived at the API boundary only"
      ]
    },
    {
      "dot": "rose",
      "title": "Deployment truth",
      "items": [
        "PostgreSQL + outbox queues wake up durable Runner workers",
        "GatewayJudge is isolated in evaluation module with cassette replay (D47)",
        "Paid live adapters require ORCH_ENABLE_PAID_ADAPTERS=true"
      ]
    }
  ]

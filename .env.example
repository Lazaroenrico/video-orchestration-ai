# ============================================================================
# .env.example — copie para `.env` e preencha suas chaves.
#   cp .env.example .env
#
# NUNCA faça commit do `.env` real (já está no .gitignore).
#
# Mapa: cada bloco abaixo corresponde a um passo do Context.md. Para rodar sem
# nenhuma chave, use `--config-dir config-mock`. O diretório `config/` é live e
# chama APIs reais, sem mock nos papéis runtime.
#
# Legenda:
#   [LIVE]   já lido pelo código hoje.
#   [FUTURO] reservado para quando o adapter real do passo for implementado.
# ============================================================================


# ----------------------------------------------------------------------------
# Steps 1, 2 e 7 — Claude via Vercel AI Gateway (conceitos, scripts e QC textual)
# Caminho recomendado para tráfego real: Vercel AI Gateway, inclusive para modelos da família Anthropic.
# ----------------------------------------------------------------------------
# [LIVE] adapter LLMPort via Vercel AI Gateway
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_LLM_MODEL=anthropic/claude-opus-4.8
# Endpoint OpenAI-compatível do Gateway é .../v1 (NÃO .../openai/v1).
# Image-only models (GPT Image 2) usam {base}/images/generations.
AI_GATEWAY_OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# Model precisa do prefixo do provider no Gateway.
AI_GATEWAY_OPENAI_MODEL=openai/gpt-image-2

# Legado / backward-compatible — provider direto, não recomendado como caminho live do projeto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8


# ----------------------------------------------------------------------------
# Step 3 — Creator reutilizável (rosto + voz)
# ----------------------------------------------------------------------------
# GPT Image 2 — geração do rosto/refs multi-ângulo via Vercel AI Gateway.
# Para MVP: use AI_GATEWAY_API_KEY (acima) — o endpoint /v1/images/generations do gateway
# roteia para GPT Image 2 (model openai/gpt-image-2). Resposta vem em base64 (b64_json).
# OPENAI_API_KEY só é necessário com o adapter direto "creator_real" (sem gateway).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Topaz direto — legado; o perfil live atual não faz upscale da imagem.
TOPAZ_API_KEY=

# ElevenLabs Voice Design API e TTS direto.
# [LIVE] Exigida pelo provider creator_vercel_elevenlabs_design quando
# voice.mode=designed. /readyz valida apenas o nome da variável, nunca seu valor.
ELEVENLABS_API_KEY=

# Replicate API (usado somente para clips PrunaAI / P-Video no perfil live atual)
REPLICATE_API_TOKEN=

# Legado (Voice Pool por .env) - Descontinuado em modo voice.mode=designed
# REPLICATE_ELEVENLABS_VOICE_ID_FEMALE=
# REPLICATE_ELEVENLABS_VOICE_ID_MALE=
# REPLICATE_ELEVENLABS_VOICE_ID_NEUTRAL=


# ----------------------------------------------------------------------------
# Steps 4 e 5 — Geração de vídeo (talking-head + product demo)
# [LIVE] usa REPLICATE_API_TOKEN com prunaai/p-video. O adapter força
# save_audio=false; Voice Design e locução usam ElevenLabs direto.
# ----------------------------------------------------------------------------
# Rate limit do Replicate no perfil live atual: geração de vídeo.
REPLICATE_MIN_INTERVAL_SECONDS=10
REPLICATE_MAX_CONCURRENCY=1

# Providers alternativos de vídeo — não usados pelo perfil live atual.
FAL_KEY=
ATLASCLOUD_API_KEY=


# ----------------------------------------------------------------------------
# Step 8 — Montagem final local com FFmpeg
# ----------------------------------------------------------------------------
# [LIVE] concatena os dois clips e muxa o TTS ElevenLabs em H.264/AAC.
# A imagem/container precisa fornecer os binários ffmpeg e ffprobe; não há chave.


# ----------------------------------------------------------------------------
# Step 7 — LLM Judge via API Gateway (avaliação determinística do QC)
# [LIVE] lido por config/judge.yaml (${JUDGE_GATEWAY_URL} / ${JUDGE_GATEWAY_KEY}).
# Sem isso, o teste do Judge roda em replay de cassette (offline). Com isso,
# `pytest tests/test_judge_eval.py --live` chama o gateway real.
# ----------------------------------------------------------------------------
JUDGE_GATEWAY_URL=
JUDGE_GATEWAY_KEY=

# ----------------------------------------------------------------------------
# Observabilidade — LangSmith (tracing + eval do Judge)
# Tracing é automático quando estas envs estão setadas (vem de usar
# LangChain/LangGraph; nada a codar). Sem elas, roda offline.
# ----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ugc-orchestrator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# `json` em staging/produção; default textual facilita o terminal local.
ORCHESTRATOR_LOG_FORMAT=

# ----------------------------------------------------------------------------
# Motor — caminhos (opcionais; têm default no código)
# ----------------------------------------------------------------------------
# ORCH_CONFIG_DIR=config
# ORCH_DB=.orchestrator/runs.sqlite
# ORCH_CREATORS=.orchestrator/creators.json
# ORCH_PROMPTS=.orchestrator/prompts.json  # templates de prompt + último usado (dashboard)
# ORCH_MEDIA=.orchestrator/media      # imagens/vozes dos creators
# ORCH_VIDEOS=.orchestrator/videos    # clips e assembled finais

# ----------------------------------------------------------------------------
# Storage S3-compatible (D30 / ADR-D36) — bytes de imagem/áudio/vídeo
# `./scripts/dev-local up` usa o R2 real por padrão. Para um smoke totalmente local:
# ORCH_DEV_STORAGE_BACKEND=local ./scripts/dev-local up
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# [OPCIONAL] endpoint S3-compatible alternativo. Vazio → endpoint R2 da Cloudflare
# derivado de R2_ACCOUNT_ID. Ex. MinIO local: http://localhost:9000
R2_ENDPOINT_URL=

# AWS cutover: a mesma imagem pode sobrescrever o backend declarado no YAML.
# `dual` lê r2:// e s3://; novas escritas vão ao backend indicado.
STORAGE_BACKEND=
STORAGE_WRITE_BACKEND=
S3_BUCKET=
AWS_REGION=sa-east-1

# Overrides exclusivos do wrapper dev-local (normalmente fornecidos inline).
# Precedência efetiva: ORCH_DEV_STORAGE_BACKEND > STORAGE_BACKEND > providers.yaml.
# ORCH_DEV_STORAGE_BACKEND=r2
# ORCH_DEV_CONFIG_DIR=config

# ----------------------------------------------------------------------------
# ADR-D36 (Cloudflare/AWS) — empacotamento OCI
# ----------------------------------------------------------------------------
# Servir /media e /videos do disco local pelo FastAPI. Default ligado (dev/local).
# Em produção com storage R2 o browser recebe URL assinada (D30): desligue com 0.
# ORCH_SERVE_LOCAL_MEDIA=1
# [LIVE] Fora do Compose, `orchestrator migrate` aplica Alembic nesta URL.
# O dev-local sempre sobrescreve as duas URLs dentro dos containers com PostgreSQL
# local em `postgres:5432`, mesmo que estes campos apontem para um banco remoto.
DATABASE_URL=
# [LIVE] URL privilegiada e direta usada só por migrate/db admin fora do dev-local.
MIGRATION_DATABASE_URL=
ORCHESTRATOR_RUNTIME_PASSWORD=
# [LIVE] Identidade local resolvida antes de abrir uma conexão tenant-scoped.
# Runner usa estes valores como service identity previamente provisionada.
ORCH_ORGANIZATION_SLUG=
ORCH_ORGANIZATION_NAME=
ORCH_USER_SUBJECT=

# [LIVE] `disabled` mantém bootstrap local; `cloudflare_access` valida JWT RS256 e
# exige membership já existente, sem conceder acesso automaticamente.
ORCH_AUTH_MODE=disabled
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=
# Opcional para ambiente hermético/teste; em staging o JWKS vem do domínio Access.
CF_ACCESS_JWKS_JSON=

# Token compartilhado entre o Worker e o Runner HTTP interno.
ORCH_INTERNAL_TOKEN=

# Wake-up externo é best-effort; PostgreSQL continua canônico.
# Valores: database | cloudflare | sqs.
ORCH_QUEUE_BACKEND=database
CF_QUEUE_PUSH_URL=
CF_API_TOKEN=
SQS_QUEUE_URL=

# Kill switch: staging deve permanecer false enquanto adapters são mock. No perfil
# live durável, true ainda exige ledger PostgreSQL e quotas administrativas para
# elevenlabs_voice_design_chars, elevenlabs_voice_slots e elevenlabs_tts_chars.
ORCH_ENABLE_PAID_ADAPTERS=false
# Desenvolvimento local: processa a fila durável dentro da própria API.
# Em deploy, deixe false e execute `orchestrator runner --once` separadamente.
ORCH_WEB_EMBEDDED_RUNNER=false
ORCH_WEB_RUNNER_POLL_INTERVAL=2
